# One local environment file belongs at the repository root: .env.local.
# Provider-injected variables take precedence over these local values.
# Local development uses only the unprefixed values below from root .env.local.
# Never copy production secrets into Preview or local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Staging uses the stable custom staging domain for both *_APP_URL and AUTH_URL.
# Its GitHub callback is <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LOG_LEVEL=info
REQUESTPORT_WORKSPACE_KEK=
REQUESTPORT_WORKSPACE_KEK_VERSION=local-v1
REQUESTPORT_WORKSPACE_KEK_PREVIOUS=
REQUESTPORT_WORKSPACE_KEK_PREVIOUS_VERSION=
REQUESTPORT_WEBHOOK_KEK=
REQUESTPORT_WEBHOOK_KEK_VERSION=local-v1
REQUESTPORT_WEBHOOK_KEK_PREVIOUS=
REQUESTPORT_WEBHOOK_KEK_PREVIOUS_VERSION=
REQUESTPORT_WEBHOOK_SIGNING_KEY=
REQUESTPORT_SLACK_SIGNING_SECRET=
REQUESTPORT_SLACK_CLIENT_ID=
REQUESTPORT_SLACK_CLIENT_SECRET=
REQUESTPORT_SLACK_STATE_SECRET=
RESEND_WEBHOOK_SECRET=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Preview deployments use only REQUESTPORT_PREVIEW_ provider values and never fall back to unprefixed local/Production values; staging is the dedicated branch that receives them for release acceptance.
# Feature previews are pre-promotion checks and never receive staging release acceptance.
REQUESTPORT_PREVIEW_DATABASE_URL=
REQUESTPORT_PREVIEW_GITHUB_CLIENT_ID=
REQUESTPORT_PREVIEW_GITHUB_CLIENT_SECRET=
REQUESTPORT_PREVIEW_RESEND_API_KEY=
REQUESTPORT_PREVIEW_RESEND_FROM_EMAIL=

# Local only. REQUESTPORT_LOCAL_DATABASE_URL names the local PostgreSQL —
# 127.0.0.1:55432 from compose.yaml — with its user and password.
# `scripts/verify-locally.mjs`, `pnpm test:webkit` and `pnpm run clean --database`
# read it, never DATABASE_URL, which a checkout pulled from Vercel fills with
# staging. The gate points DATABASE_URL at it and runs every step on pg. pg
# dials the host the string names, and takes a `host`, `port`, `user` or
# `password` in the query over the one before it, so the gate refuses a host
# that is not this machine and any query parameter but sslmode and
# application_name.
REQUESTPORT_LOCAL_DATABASE_URL=

# Sign-in methods. Outside a Vercel production deployment, GitHub
# (GITHUB_CLIENT_ID + GITHUB_CLIENT_SECRET) and the emailed magic link
# (RESEND_API_KEY + RESEND_FROM_EMAIL) are each optional: a pair is complete or
# absent, and half a pair refuses to boot. VERCEL_ENV=production refuses to boot
# without all four. A Vercel Preview reads the REQUESTPORT_PREVIEW_ pairs above
# under the same rule and never these. Absent means unset: an empty value, as
# the lines above are written, is refused. Without the Resend pair the magic
# link is not offered, the worker's email-delivery task fails every email with
# provider_unavailable, and /api/providers/resend answers 503.
#
# REQUESTPORT_LOCAL_CREDENTIAL (enabled|disabled) switches the local owner
# credential: an email-and-password sign-in, with sign-up disabled, for the
# credential the private operator CLI's `requestport-operator bootstrap-owner
# --local-credential` issues and `--rotate-local-credential` replaces, or a
# self-host's first `requestport start` prints. It is for local and self-hosted
# use: wherever VERCEL_ENV is set — production, preview, development, any value
# — it is off, and this switch cannot turn it on. Without VERCEL_ENV, unset, it
# is on when neither GitHub nor the magic link is configured and off when
# either is; `enabled` turns it on beside the external methods, and `disabled`
# turns it off even when it is the only way in. A local process whose
# environment sets VERCEL_ENV, empty included, has it off too. Any value of
# this switch other than enabled or disabled, empty included, refuses to boot,
# so leave the line commented unless you set it.
# REQUESTPORT_LOCAL_CREDENTIAL=disabled

# REQUESTPORT_OPERATOR_CREDENTIALS (enabled|disabled) switches operator
# credentials: the rpo_ keys a person issues at /settings/operators for a
# script, a CI job or the self-host CLI to act on /api/v1 with that person's
# live authority. Unset or disabled, they are off: none can be issued, and a
# live one is refused at authentication (401) and at command time (403). It is
# on only with enabled, once the operator_credentials table exists, and only
# where Better Auth's /change-password is closed (in disabledPaths); while that
# endpoint is mounted the switch changes nothing. Setting it in production is
# the owner's step, taken after the migration is recorded and the
# /change-password closure is live, with a redeploy. Turning it off stops every
# operator credential on the next deployment without revoking any; turning it
# on again restores those still live. Any other value, empty included, refuses
# to boot, so leave the line commented unless you set it.
# REQUESTPORT_OPERATOR_CREDENTIALS=enabled

# REQUESTPORT_WEBHOOK_PRIVATE_RECEIVERS (enabled, or unset) is a self-hosted
# RequestPort's opt-in for private and loopback webhook receivers: loopback
# (127.0.0.0/8, ::1), RFC 1918 (10/8, 172.16/12, 192.168/16), shared address
# space (100.64/10) and IPv6 unique-local (fc00::/7). Unset, the endpoint
# policy refuses each of those, at registration and at every delivery, as it
# always did. Enabled, the policy admits them there, and a receiver whose
# every address is in those ranges may use plain http and any port, so
# http://192.168.1.5:8080/ is admitted even where NODE_ENV is production, as
# requestport start sets it. Every other receiver keeps the rules it had:
# https, on its default port or 443.
# Link-local (169.254/16, fe80::/10), the known cloud metadata endpoints
# inside the admitted ranges (a list, not every address a cloud may use),
# unspecified, multicast, broadcast and the other reserved ranges stay
# refused either way. The web server, requestport start and the worker each
# read it. It is refused wherever VERCEL_ENV is set, any value, empty
# included, and wherever REQUESTPORT_JOB_RUNNER is not postgres, as on the
# Trigger.dev worker. Any value other than enabled, empty included, refuses
# to boot, so leave the line commented unless you set it.
# REQUESTPORT_WEBHOOK_PRIVATE_RECEIVERS=enabled

# Which runner executes background jobs, read by packages/jobs/src/selection.ts
# and checked when the web server and the worker boot, so a bad value stops
# either from starting rather than failing its first dispatch. Exactly three
# answers are accepted:
#   unset or empty  Trigger.dev. Production leaves this unset.
#   trigger         Trigger.dev, stated explicitly.
#   postgres        The `requestport-jobs` worker in packages/jobs
#                   (`pnpm --filter @requestport/jobs worker`), which drains
#                   the same tables in the application's database, connecting
#                   only as the worker's three logins (the last three variables
#                   in this file). It refuses to start without all three, and
#                   under any other value of this one. Refused wherever
#                   VERCEL_ENV is set, empty included: no worker runs on
#                   Vercel, so nothing would drain the outbox.
# Anything else is refused with a message naming this variable, never read as
# Trigger.dev.
REQUESTPORT_JOB_RUNNER=

# The database driver. Unset or empty selects this build's default
# (`DEFAULT_DRIVER` in packages/db/src/hosted-driver.ts): in the private
# repository the hosted driver production runs, which its own name
# (`HOSTED_DRIVERS` there) selects too, the default everywhere, Vercel and the
# Trigger.dev worker included, exactly as before; in the public tree, pg.
# `pg` selects node-postgres over TCP, which reaches a plain
# PostgreSQL (the local one on 127.0.0.1:55432) with no WebSocket proxy. Local
# development sets `pg` in .env.local, with DATABASE_URL naming the local
# database. The gate sets `pg` for its own steps when this is empty and refuses
# any other value. Under
# `pg` the connection string must name its user and a non-empty password;
# PGOPTIONS, PGAPPNAME, PGREPLICATION, PGBINARY, PGCLIENT_ENCODING and
# PGSSLNEGOTIATION must be unset; and a string naming production, or
# staging's own database, is refused unless REQUESTPORT_PRODUCTION_DATABASE
# or REQUESTPORT_STAGING_DATABASE reads `approved`. `pglite` selects the
# single-session PGlite test lane and is refused wherever VERCEL_ENV is set.
# Any other value stops the process when packages/db loads.
REQUESTPORT_DATABASE_DRIVER=

# The PGlite lane's own variable: where its database lives, a directory (or
# memory://, which the lane itself refuses because each test file would get
# an empty database). Read only when REQUESTPORT_DATABASE_DRIVER=pglite, which
# then requires it. `pnpm --filter @requestport/db test:pglite` runs the lane
# with no server: unset, it makes and migrates a temporary directory, removed
# when the run exits. Not part of the gate. Leave it empty here.
REQUESTPORT_PGLITE_DATA_DIR=

# The MCP endpoint's 2026-07-28 protocol leg (server/discover and the
# per-request envelope), served beside the 2025 one. Off unless this is exactly
# "enabled"; any other value, or unset, leaves every request on the 2025 wire.
# Turning it on in a deployment takes a redeploy. Production leaves it unset.
REQUESTPORT_MCP_MODERN=
# Client ID Metadata Documents: an agent names an https URL as its client_id,
# and the authorisation server fetches the client's metadata from it. Off
# unless REQUESTPORT_OAUTH_CIMD is exactly "enabled"; any other value, or
# unset, leaves it off. On, REQUESTPORT_OAUTH_CIMD_ALLOWED_ORIGINS must list,
# comma-separated, the https origins documents may be fetched from (no path,
# query, fragment, userinfo or wildcard); a missing, empty or invalid list
# stops the web application's Better Auth from starting rather than letting
# any client choose a URL the server fetches. Set both together, then
# redeploy. Production leaves both unset.
REQUESTPORT_OAUTH_CIMD=
REQUESTPORT_OAUTH_CIMD_ALLOWED_ORIGINS=
# The application's own database role (Plan 13, Track I.2;
# docs/implementation/plans/2026-09-27-13/manifest-i2.md §1). A login role that
# owns nothing and cannot bypass row-level security. Only a storage built
# from the application's options (packages/db's
# applicationStorageOptionsFromEnv) connects through it: the application
# root in packages/db's wiring, which the web application, REST, MCP and
# Better Auth share, and whose pool reads are wrapped in transactions bound
# to one organisation; and a suite's storage built the same way, as
# role-guard.test.ts builds one wherever this is set. Migrations, the
# operator CLI, and every storage a suite or the browser lanes' fixtures
# build with storageOptionsFromEnv connect through DATABASE_URL, the owner,
# whatever this says. No worker builds such a storage: the worker connects
# only through the three variables below. Unset or blank, the application's
# storage refuses to connect, naming this variable: since I.2's step 5 it
# never falls back to DATABASE_URL. Since then it also refuses, on its first
# use, a login that is a superuser, can bypass row-level security, owns a
# table in public, or is a member of a role that is or does either; so
# DATABASE_URL's own value does not work here. Previews never read it; a
# preview's application reads REQUESTPORT_PREVIEW_DATABASE_URL instead. For
# pnpm dev, scripts/create-track-worktree.mjs writes a track's own login,
# <database>_dev_app, here when it writes the track's .env.local: a member
# of requestport_application alone, made on the local server after the
# migration. A track whose .env.local was written before I.2's step 5, or
# kept, makes one by hand, once its local database is migrated (the group
# comes from migration 0019), as that local database's owner. Do this only
# where DATABASE_URL names a PostgreSQL on this machine (127.0.0.1). A
# checkout whose .env.local was pulled from Vercel names a cloud database
# there (staging, above), and this must never run against it. For example,
# with psql against the local DATABASE_URL:
#   set scram_iterations = 1;
#   create role <name> login password '<password>' nosuperuser nobypassrls
#     nocreatedb nocreaterole noreplication in role requestport_application;
# and sets this variable to DATABASE_URL with that login's name and password
# in place of the owner's. The migration launcher strips it from its child's
# environment. Since I.2's step 7 the application's storage is also refused,
# at its first query, in a process whose environment names DATABASE_URL, any
# DATABASE_URL_*, or any PG* or POSTGRES_* variable, whatever its value,
# naming the variables and never a value. So pnpm dev hands the web
# application none of them: it runs scripts/with-root-env.mjs
# --without-owner-variables, which removes each after this file has filled
# the environment and says so, one line each, and the web application then
# connects only through this variable. DATABASE_URL here still serves
# migrations, the suites and the operator CLI, none of which takes that
# flag. The acceptance server likewise hands its server none of them, and
# passes the owner's URL to its scenario hook as
# REQUESTPORT_E2E_OWNER_DATABASE_URL, which only an E2E server reads; it is
# not set here.
REQUESTPORT_APPLICATION_DATABASE_URL=
# The worker's three database roles (Plan 13, Track I.2b; manifest-i2.md
# §5.1). Each is a login role that owns nothing, cannot bypass row-level
# security, and is a member of exactly one group: requestport_dispatcher
# (claims, acceptance and release by lease, discovery),
# requestport_tenant_processor (every processing step, in a transaction bound
# to one organisation) and requestport_maintenance (the metrics snapshot, the
# outbox backlog and retention). A worker on PostgreSQL needs all three: the
# Trigger.dev tasks, requestport-jobs and requestport worker claim, process
# and maintain only through them, and with any of them unset each refuses to
# run, naming the unset ones. No step falls back to DATABASE_URL, and with
# all three set, and VERCEL_ENV unset, the worker needs no DATABASE_URL. Each
# of the three storages also refuses a login that is a superuser, can bypass
# row-level security, owns a table in public, is a member of a role that is
# a superuser or can bypass it, or is not a member of exactly its own group;
# and, since I.2b's b6, an environment that names DATABASE_URL, any
# DATABASE_URL_* (DATABASE_URL_UNPOOLED among them), or any PG* or POSTGRES_*
# variable, whatever its value, empty included. The refusal comes at each
# storage's first use, and its error names the variable, never its value.
# requestport-jobs and requestport worker refuse sooner: they exit 2 before
# starting, naming the variables and never a value.
# The web application never reads them. requestport start on PostgreSQL
# creates its instance's own three, removes those names from its own
# environment before it serves, and on PGlite its worker needs none. For
# a local worker, create three logins in the local database, one per group,
# for example
#   create role <name> login password '<password>' in role requestport_dispatcher;
# and set each variable to the local database's URL with that login's name
# and password. A local worker runs with its three logins and without
# DATABASE_URL. `pnpm --filter @requestport/jobs worker` runs requestport-jobs
# so: it fills every name .env.local sets and the shell does not, then
# removes DATABASE_URL and every other of the names above, one line each on
# standard error (scripts/with-root-env.mjs --without-owner-variables). Set
# REQUESTPORT_JOB_RUNNER=postgres and the three in the shell that runs it.
# requestport worker has no such script: give it a file of its own,
# .env.local's values without DATABASE_URL or any other of the names above,
# plus REQUESTPORT_JOB_RUNNER=postgres and the three, and run, from the
# repository root and a shell that exports none of those names (a variable
# the shell already sets wins over the file),
#   node --env-file=<that file> apps/requestport/bin/requestport.mjs worker
REQUESTPORT_DISPATCHER_DATABASE_URL=
REQUESTPORT_TENANT_PROCESSOR_DATABASE_URL=
REQUESTPORT_MAINTENANCE_DATABASE_URL=
