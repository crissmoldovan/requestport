{
  "name": "@requestport/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth-handler": "./src/auth-handler.ts",
    "./client": "./src/client.ts",
    "./create-auth": "./src/create-auth.ts",
    "./e2e": "./src/e2e-email-outbox.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "auth:schema": "NODE_ENV=development node ../../scripts/with-root-env.mjs better-auth generate --config src/auth-schema.config.ts --adapter drizzle --dialect pg --output ../../.superpowers/sdd/better-auth-schema.generated.ts --yes",
    "build": "tsc -p tsconfig.json",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.6",
    "@better-auth/cimd": "1.7.6",
    "@better-auth/core": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@react-email/render": "2.1.0",
    "@requestport/config": "workspace:*",
    "@requestport/core": "workspace:*",
    "@requestport/db": "workspace:*",
    "@requestport/domain": "workspace:*",
    "better-auth": "1.7.6",
    "better-call": "1.4.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.9",
    "kysely": "0.29.5",
    "react": "19.2.8",
    "resend": "6.20.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "auth": "1.7.6"
  }
}
