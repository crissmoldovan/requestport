{
  "name": "@requestport/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./e2e": "./src/e2e-owner-storage.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts",
    "./wiring": "./src/wiring.ts"
  },
  "dependencies": {
    "@requestport/domain": "workspace:*",
    "@requestport/notifications": "workspace:*",
    "@requestport/webhooks": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pglite": "REQUESTPORT_DATABASE_DRIVER=pglite vitest run",
    "db:generate": "NODE_ENV=development node ../../scripts/with-root-env.mjs drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "NODE_ENV=development node ../../scripts/with-root-env.mjs drizzle-kit migrate --config drizzle.config.ts"
  }
}
