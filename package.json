{
  "name": "requestport",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node scripts/with-root-env.mjs turbo run build",
    "dev": "node scripts/with-root-env.mjs --without-owner-variables turbo run dev --parallel",
    "lint": "node scripts/with-root-env.mjs turbo run lint",
    "typecheck": "node scripts/with-root-env.mjs turbo run typecheck",
    "test": "node scripts/with-root-env.mjs node --test scripts/*.test.mjs packages/db/scripts/*.test.mjs && node scripts/with-root-env.mjs turbo run test",
    "prepare": "node scripts/install-git-hooks.mjs",
    "clean": "node scripts/clean-locally.mjs",
    "test:webkit": "node scripts/run-webkit-lanes.mjs",
    "test:e2e": "node scripts/with-root-env.mjs node scripts/run-foundation-e2e.mjs",
    "migrations:status": "node scripts/migration-state.mjs",
    "db:generate": "node scripts/with-root-env.mjs pnpm --filter @requestport/db db:generate",
    "db:migrate": "node scripts/with-root-env.mjs pnpm --filter @requestport/db db:migrate",
    "docs:diagrams": "for f in docs/diagrams/*.mmd; do mmdc -i \"$f\" -o \"${f%.mmd}.svg\" -b white; done",
    "lint:scripts": "biome check scripts",
    "seed:scripts": "node scripts/seed-scripts-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@mermaid-js/mermaid-cli": "11.16.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.12",
    "puppeteer": "25.7.0",
    "turbo": "2.10.10",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
